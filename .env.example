# ===========================================
# SciInov DBMS Environment Configuration Template
# ===========================================
# Copy this file to .env and update values with your actual credentials

# ===========================================
# MongoDB Configuration
# ===========================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?appName=appname

# ===========================================
# JWT Configuration
# ===========================================
JWT_SECRET=your-256-bit-secret-key-here
JWT_EXPIRATION_MS=86400000

# ===========================================
# Server Configuration
# ===========================================
SERVER_PORT=8080

# ===========================================
# SMTP Mail Configuration (Gmail Example)
# ===========================================
# For Gmail: Enable 2FA and create App Password at https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM=noreply@yourdomain.com
MAIL_FROM_NAME=SciInov DBMS

# ===========================================
# Google Cloud Storage Configuration
# ===========================================
# Create a service account at https://console.cloud.google.com/iam-admin/serviceaccounts
# Download the JSON key and set the path below
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-bucket-name
GCS_CREDENTIALS_PATH=/path/to/service-account-key.json

# ===========================================
# Application Configuration
# ===========================================
APP_BASE_URL=http://localhost:8080

