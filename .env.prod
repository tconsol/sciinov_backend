# ===========================================
# SciInov DBMS - Production Environment Configuration
# ===========================================
# DO NOT commit this file to version control
# This file contains production secrets and credentials

# ===========================================
# Server Configuration
# ===========================================
SERVER_PORT=8080

# ===========================================
# MongoDB Configuration - Production Atlas
# ===========================================
# Example: mongodb+srv://user:pass@cluster.mongodb.net/sciinovdbms?appName=sciinovdbms
MONGODB_URI=mongodb+srv://sciinovdbms:Sciinovdbms123@sciinovdbms.jzwqqwk.mongodb.net/sciinovdbms?appName=sciinovdbms

# ===========================================
# JWT Configuration - Generate New Secret
# ===========================================
# Generate with: openssl rand -hex 32
JWT_SECRET=your-production-jwt-secret-256-bit-hex-64-characters
# 24 hours in milliseconds
JWT_EXPIRATION_MS=86400000

# ===========================================
# File Upload Configuration
# ===========================================
MAX_FILE_SIZE=50MB
MAX_REQUEST_SIZE=50MB

# ===========================================
# SMTP Mail Configuration - Production Gmail
# ===========================================
# 1. Enable 2-Factor Authentication on Google Account
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character app password below
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM=noreply@sciinov.com
MAIL_FROM_NAME=SciInov DBMS
MAIL_TIMEOUT=5000

# ===========================================
# Google Cloud Storage Configuration
# ===========================================
# 1. Create GCP Project
# 2. Create Service Account
# 3. Download credentials JSON
# 4. Save as fineflux-c0bba53c7d23.json in project root
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-bucket-name
GCS_CREDENTIALS_PATH=./fineflux-c0bba53c7d23.json

# ===========================================
# Application URLs - Production Domain
# ===========================================
APP_BASE_URL=https://api.yourdomain.com
APP_FRONTEND_BASE_URL=https://app.yourdomain.com
APP_PASSWORD_RESET_URL=https://app.yourdomain.com/reset-password
APP_FORGOT_PASSWORD_URL=https://app.yourdomain.com/forgot-password

# ===========================================
# CORS Configuration - Production Domains
# ===========================================
# Comma-separated list of allowed frontend origins
APP_CORS_ALLOWED_ORIGINS=https://app.yourdomain.com

# ===========================================
# Logging Configuration - Production
# ===========================================
# Keep INFO for application, WARN for third-party libraries
LOG_LEVEL_ROOT=WARN
LOG_LEVEL_APP=INFO
LOG_LEVEL_CONTROLLER=INFO
LOG_LEVEL_SERVICE=INFO
LOG_LEVEL_SECURITY=INFO
LOG_LEVEL_SPRING=WARN
LOG_LEVEL_SPRING_SEC=WARN
LOG_LEVEL_MONGO=WARN
LOG_FILE_PATH=/var/log/sciinovdbms/application.log
LOG_MAX_SIZE=10MB
LOG_MAX_HISTORY=30

# ===========================================
# Swagger/OpenAPI - Disable in Production
# ===========================================
# Set to false for production (security)
SWAGGER_UI_ENABLED=false

# ===========================================
# Session Configuration - HTTPS
# ===========================================
# Set to true when using HTTPS (required for production)
SESSION_SECURE=true

# ===========================================
# Task Execution Configuration
# ===========================================
# Adjust based on your server resources
TASK_CORE_SIZE=5
TASK_MAX_SIZE=10
TASK_QUEUE_SIZE=100

