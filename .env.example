# ===========================================
# SciInov DBMS - Environment Configuration Template
# ===========================================
# Copy this file to .env and update with your actual values
# DO NOT commit .env file to Git (it contains sensitive data)

# ===========================================
# Server Configuration
# ===========================================
SERVER_PORT=8080
LOG_LEVEL_ROOT=WARN
LOG_LEVEL_APP=INFO
LOG_LEVEL_CONTROLLER=INFO
LOG_LEVEL_SERVICE=INFO
LOG_LEVEL_SECURITY=INFO
LOG_LEVEL_SPRING=WARN
LOG_LEVEL_SPRING_SEC=WARN
LOG_LEVEL_MONGO=WARN
LOG_FILE_PATH=logs/application.log
LOG_MAX_SIZE=10MB
LOG_MAX_HISTORY=30

# ===========================================
# MongoDB Configuration
# ===========================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?appName=appname

# ===========================================
# JWT Configuration
# ===========================================
# Generate with: openssl rand -hex 32
JWT_SECRET=your-256-bit-hex-secret-key
JWT_EXPIRATION_MS=86400000

# ===========================================
# File Upload Configuration
# ===========================================
MAX_FILE_SIZE=50MB
MAX_REQUEST_SIZE=50MB

# ===========================================
# SMTP Mail Configuration
# ===========================================
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=your-email-password
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=SciInov DBMS
MAIL_TIMEOUT=5000

# ===========================================
# Google Cloud Storage Configuration
# ===========================================
GCS_PROJECT_ID=your-project-id
GCS_BUCKET_NAME=your-bucket-name
GCS_CREDENTIALS_PATH=./your-credentials.json

# ===========================================
# Application URLs
# ===========================================
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_BASE_URL=http://localhost:3000
APP_PASSWORD_RESET_URL=http://localhost:3000/reset-password
APP_FORGOT_PASSWORD_URL=http://localhost:3000/forgot-password
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://sciinovdbms.com

# ===========================================
# Swagger Documentation
# ===========================================
SWAGGER_UI_ENABLED=false

# ===========================================
# Session Management
# ===========================================
SESSION_MAX_AGE=86400
SESSION_SECURE=false

# ===========================================
# Task Execution
# ===========================================
TASK_CORE_SIZE=5
TASK_MAX_SIZE=10
TASK_QUEUE_SIZE=100

