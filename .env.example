# ===========================================
# SciInov DBMS - Environment Configuration Template
# ===========================================
# IMPORTANT: This is for PRODUCTION use in GCP Cloud Run
# For LOCAL DEVELOPMENT: Use .env.local instead
#
# Copy this file to .env for production deployment
# DO NOT commit .env or .env.local to Git (they contain sensitive data)

# ===========================================
# Server Configuration
# ===========================================
SERVER_PORT=8080
LOG_LEVEL_ROOT=WARN
LOG_LEVEL_APP=INFO
LOG_LEVEL_CONTROLLER=INFO
LOG_LEVEL_SERVICE=INFO
LOG_LEVEL_SECURITY=INFO
LOG_LEVEL_SPRING=WARN
LOG_LEVEL_SPRING_SEC=WARN
LOG_LEVEL_MONGO=WARN
LOG_FILE_PATH=logs/application.log
LOG_MAX_SIZE=10MB
LOG_MAX_HISTORY=30

# ===========================================
# Tomcat Configuration (for production)
# ===========================================
TOMCAT_MAX_THREADS=1000
TOMCAT_MIN_THREADS=100
TOMCAT_ACCEPT_COUNT=1000
TOMCAT_MAX_CONNECTIONS=20000
TOMCAT_CONNECTION_TIMEOUT=600000
TOMCAT_KEEP_ALIVE_TIMEOUT=600000

# ===========================================
# MongoDB Configuration
# ===========================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?appName=appname
MONGODB_MAX_POOL_SIZE=200
MONGODB_MIN_POOL_SIZE=20
MONGODB_MAX_IDLE_TIME=30000
MONGODB_MAX_LIFE_TIME=0
MONGODB_SOCKET_TIMEOUT=300000
MONGODB_SERVER_TIMEOUT=15000

# ===========================================
# JWT Configuration
# ===========================================
# Generate with: openssl rand -hex 32
JWT_SECRET=your-256-bit-hex-secret-key
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_DAYS=7

# ===========================================
# File Upload Configuration
# ===========================================
MAX_FILE_SIZE=200MB
MAX_REQUEST_SIZE=200MB

# ===========================================
# SMTP Mail Configuration
# ===========================================
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=your-email-password
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=SciInov DBMS
MAIL_TIMEOUT=5000

# ===========================================
# Google Cloud Storage Configuration
# ===========================================
GCS_PROJECT_ID=your-project-id
GCS_BUCKET_NAME=your-bucket-name
GCS_TYPE=service_account
GCS_PRIVATE_KEY_ID=your-key-id
GCS_PRIVATE_KEY=your-private-key
GCS_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GCS_CLIENT_ID=your-client-id
GCS_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GCS_TOKEN_URI=https://oauth2.googleapis.com/token
GCS_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GCS_CLIENT_X509_CERT_URL=your-cert-url
GCS_UNIVERSE_DOMAIN=googleapis.com

# ===========================================
# Application URLs (PRODUCTION)
# ===========================================
# For GCP Cloud Run production deployment
APP_BASE_URL=https://sciinov-643072216061.asia-south1.run.app
APP_FRONTEND_BASE_URL=https://sciinovdbms.com
APP_PASSWORD_RESET_URL=https://sciinovdbms.com/reset-password
APP_FORGOT_PASSWORD_URL=https://sciinovdbms.com/forgot-password

# ===========================================
# CORS Configuration (PRODUCTION ONLY)
# ===========================================
# Only production domain - NO localhost here!
# For local development, use .env.local instead
APP_CORS_ALLOWED_ORIGINS=https://sciinovdbms.com

# ===========================================
# Swagger Documentation
# ===========================================
SWAGGER_UI_ENABLED=false

# ===========================================
# Session Management (PRODUCTION)
# ===========================================
SESSION_MAX_AGE=604800
SESSION_SECURE=true

# ===========================================
# Task Execution
# ===========================================
TASK_CORE_SIZE=20
TASK_MAX_SIZE=50
TASK_QUEUE_SIZE=500

# ===========================================
# For Local Development (use .env.local)
# ===========================================
# Copy the contents of .env.local to a file named .env for local development
# The .env.local file includes:
# - APP_CORS_ALLOWED_ORIGINS with http://localhost:5173
# - APP_BASE_URL set to http://localhost:8080
# - SESSION_SECURE set to false
# - SWAGGER_UI_ENABLED set to true
